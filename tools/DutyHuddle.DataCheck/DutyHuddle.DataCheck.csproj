<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Validates the duty catalog and the Wondrous Tails rules against the real game files, without running
    the game. Usage: see README.md (pass the FFXIV install folder as the only argument).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\DutyHuddle\GameAdapters\GameDataRepository.cs" Link="Linked\GameDataRepository.cs" />
    <Compile Include="..\..\src\DutyHuddle\GameAdapters\ISheetSource.cs" Link="Linked\ISheetSource.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)Lumina.dll" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudLibPath)Lumina.Excel.dll" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DutyHuddle.Domain\DutyHuddle.Domain.csproj" />
  </ItemGroup>

</Project>
