{
  // DutyHuddle sharing server on Cloudflare Workers (free plan: SQLite-backed Durable Objects).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dutyhuddle-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // The server stores only ciphertext and keeps no request logs.
  "observability": { "enabled": false }
}
